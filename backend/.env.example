DATABASE_URL=postgres://user:pass@host:5432/dbname

# Admin JWT signing secret — MUST be set to a strong random value in production
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_JWT_SECRET=change-me-in-prod

# Admin token TTL, e.g. 8h, 1h, 30m
ADMIN_TOKEN_TTL=8h

# Data encryption key for field-level encryption at rest (AES-256-GCM)
# MUST be 32 bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
