{
  "name": "aep-client",
  "version": "1.1.0",
  "description": "Drop-in SSO wrapper for consuming apps using the AEP broker. Ships as a single Node SEA binary.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "rebuild-assets": "powershell -ExecutionPolicy Bypass -File rebuild-assets.ps1",
    "build:win": "powershell -ExecutionPolicy Bypass -File build-sea.ps1",
    "build:linux": "powershell -ExecutionPolicy Bypass -File build-sea.ps1 -Target linux",
    "build:macos": "powershell -ExecutionPolicy Bypass -File build-sea.ps1 -Target macos"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "postject": "^1.0.0-alpha.6"
  }
}

